---
/** Каркас кабинета avtoball.ru – перенос кабинета gaz-mag (стандарт Milovini: вкладки и шапка Elite Rose / ALEX KROWN v1),
    адрес сайта справа, «Выйти». Весь кабинет закрыт логином и паролем (scripts/lock-admin.mjs при выкладке), закрыт от поиска.
    Владелец 01.11.2026: «админку по сайту подними полностью: заявки, SEO, страницы по категориям и городам, Метрика по городам;
    нейросети и платный XMLRiver не надо». Товаров нет (сайт-рейтинг) – вкладки «Товары» нет; Позиции и Рекомендации – под замком. */
import '../styles/admin.css';
import { u } from '../lib/url';
type Tab = 'pages' | 'leads' | 'metrika' | 'seo' | 'positions' | 'recommendations';
interface Props { title: string; active: Tab }
const { title, active } = Astro.props;
const site = new URL(u('/'), Astro.site).href;
const tabs: [Tab, string, string, string][] = [
  ['pages', '/admin/', 'Страницы сайта', ''],
  ['leads', '/admin/leads/', 'Заявки', ''],
  ['metrika', '/admin/metrika/', 'Метрика', ''],
  ['seo', '/admin/seo/', 'SEO-аналитика', ''],
  ['positions', '/admin/positions/', 'Позиции', '🔒'],
  ['recommendations', '/admin/recommendations/', 'Рекомендации', '🔒'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – кабинет Автобалла</title>
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="adm">
    <nav class="topnav" aria-label="Разделы кабинета">
      <span class="brand"><img src={u('/favicon.svg')} alt="" />АВТОБАЛЛ</span>
      {tabs.map(([key, href, label, n]) => (
        <a class:list={['tab', { on: active === key }]} href={u(href)}>{label}{n && (n === '🔒' ? <span class="lk" aria-label="раздел закрыт"> 🔒</span> : <span class="n">{n}</span>)}</a>
      ))}
      <span class="site" title="Боевой режим: сайт на сервере, заявки – в своём приёмнике">🟢 Боевой сайт · Сайт: <a href={site} target="_blank" rel="noopener">{site.replace(/^https?:\/\//, '')}</a></span>
      <button type="button" class="logout" onclick="try{sessionStorage.removeItem('ab_admin_auth');localStorage.removeItem('ab_admin_keep')}catch(e){};location.reload()" style="background:none;border:0;color:rgba(255,255,255,.75);font:inherit;font-size:13px;cursor:pointer;padding:0">Выйти</button>
    </nav>
    <main><slot /></main>
  </body>
</html>
