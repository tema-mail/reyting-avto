---
// Шапка: «Рейтинги» – раскрывающийся список по 5 группам (на телефоне – группы ссылками на хаб).
import Logo from './Logo.astro';
import { u } from '../lib/url';
import { BY_GROUP } from '../lib/katalog';
import { CITY } from '../lib/site';
interface Props { active?: string }
const { active = '' } = Astro.props;
const cur = (key: string) => (active === key ? 'page' : undefined);
---
<header class="top">
  <div class="wrap top__in">
    <Logo />
    <nav class="nav" aria-label="Главное меню">
      <a href={u(`/${CITY.slug}/`)} aria-current={cur('city')}>{CITY.name}</a>
      <details>
        <summary>Рейтинги</summary>
        <div class="nav__drop nav__mega">
          {BY_GROUP.map((g) => (
            <div>
              <p>{g.name}</p>
              {g.items.map((r) => <a href={u(r.url)} aria-current={cur(r.key)} style="display:block">{r.crumb}</a>)}
            </div>
          ))}
          <a class="nav__all" href={u(`/${CITY.slug}/`)}>Все рейтинги {CITY.of} →</a>
        </div>
      </details>
      <a href={u('/metodika/')} aria-current={cur('metodika')}>Методика</a>
      <a class="btn btn--top" href={u('/dobavit-kompaniyu/')}>Добавить компанию</a>
    </nav>
    <details class="burger">
      <summary>Меню</summary>
      <nav class="burger__panel" aria-label="Меню на телефоне">
        <a href={u(`/${CITY.slug}/`)}>Все рейтинги: {CITY.name}</a>
        {BY_GROUP.map((g) => <a class="burger__sub" href={u(`/${CITY.slug}/#${g.slug}`)}>{g.name} · {g.items.length}</a>)}
        <a href={u('/metodika/')}>Методика</a>
        <a href={u('/o-proekte/')}>О проекте</a>
        <a class="btn btn--signal" href={u('/dobavit-kompaniyu/')}>Добавить компанию</a>
      </nav>
    </details>
  </div>
</header>
