---
// Таблица топ-20 ниши Яндекса + строка «Ещё в рейтинге» + фильтры (район, круглосуточно, 4,8+, 300+, «Хорошее место», сайт,
// цены на сайте). Сеть – одна строка: адрес главной точки (по ней балл) и «ещё N филиалов» с адресами.
// Фильтр только скрывает строки, место не меняет. На телефоне строки – карточки (классы .rt как в старых нишах).
import type { NicheYa, YaRow } from '../../lib/ya';
import { flags, FILTERS, rt, otz, rub } from '../../lib/ya-tekst';
import { TOP } from '../../lib/formula-ya.mjs';
import { plural } from '../../lib/format';
import { score, num, date } from '../../lib/format';
import { u } from '../../lib/url';
import { RAYONY, OUTSIDE } from '../../lib/rayony.mjs';
import Gauge from '../Gauge.astro';
interface Props { n: NicheYa }
const { n } = Astro.props;
const id = `f-${n.key}`;
const present = new Set(n.rows.flatMap((r) => r.rayony));
const rayony = [...RAYONY.filter((r: string) => present.has(r)), ...(present.has(OUTSIDE) ? [OUTSIDE] : [])];
const filters = FILTERS.filter(([k]) => n.rows.some((r) => flags(r).includes(k)));
const attrs = (r: YaRow) => ({ 'data-rayony': r.rayony.join('|'), 'data-f': flags(r).join(' ') });
const more = (r: YaRow) => r.branches.length - 1;
const moreLabel = (k: number) => `ещё ${k} ${plural(k, ['филиал', 'филиала', 'филиалов'])}`;
const hasPrices = n.rows.some((r) => r.prices.length);
---
<div class="flt" data-filter={id} aria-label="Фильтры рейтинга">
  <div class="flt__row">
    {rayony.length > 0 ? (
    <label class="flt__sel"><span>Район</span>
      <select data-rayon>
        <option value="">Все районы</option>
        {rayony.map((r) => <option value={r}>{r}</option>)}
      </select>
    </label>
    ) : <select data-rayon hidden aria-hidden="true"><option value=""></option></select>}
    <div class="chips flt__chips" role="group" aria-label="Признаки">
      {filters.map(([k, label]) => <label><input type="checkbox" value={k} /><span>{label}</span></label>)}
    </div>
  </div>
  <p class="small muted flt__count" aria-live="polite" data-count>Показаны все {n.rows.length}. Фильтр скрывает строки, места не меняются.</p>
</div>

<div class="rt-wrap" id={id}>
  <table class="rt rt--ya">
    <caption class="sr-only">{n.t.h1}: первые {TOP} мест</caption>
    <thead>
      <tr>
        <th scope="col">№</th>
        <th scope="col">Компания</th>
        <th scope="col">Балл</th>
        <th scope="col">Яндекс Карты</th>
        <th scope="col">Последний отзыв</th>
        <th scope="col">Где</th>
        {hasPrices && <th scope="col">Цены на сайте</th>}
      </tr>
    </thead>
    <tbody>
      {n.top.map((r) => (
        <tr class={[r.place <= 3 && 'top3', r.partner && 'is-pick'].filter(Boolean).join(' ') || undefined} {...attrs(r)}>
          <td class="pos">{r.place}</td>
          <td class="co">{r.url ? <a href={u(r.url)}>{r.display}</a> : <span>{r.display}</span>}{(r.allDay || r.good) && <span class="tags">{r.allDay && <span class="tag">24 часа</span>}{r.good && <span class="tag">Хорошее место</span>}</span>}</td>
          <td class="sc">{r.partner ? <b class="pick">Выбор редакции</b> : <>{score(r.score)}<Gauge value={r.score} signal={r.place <= 3} /></>}</td>
          <td class="x num" data-l="Яндекс Карты"><span>{rt(r.rating)}<span class="cnt"><span class="dot"> · </span>{otz(r.reviews)}</span></span></td>
          <td class="x num" data-l="Последний отзыв">{r.last ? date(r.last) : <mark class="confirm">нет даты</mark>}</td>
          <td class="x" data-l="Где"><span>{r.branches[0].address}{r.branches[0].rayon ? ` · ${r.branches[0].rayon}` : ''}{more(r) > 0 && (
            <details class="fil"><summary>{moreLabel(more(r))}</summary><ul>{r.branches.slice(1).map((b) => <li>{b.address}{b.rayon ? ` · ${b.rayon}` : ''}</li>)}</ul></details>
          )}</span></td>
          {hasPrices && <td class="x num" data-l="Цены на сайте">{r.prices.length ? <span title={r.prices[0].name}>{rub(r.prices[0].from)}</span> : <span class="muted">–</span>}</td>}
        </tr>
      ))}
    </tbody>
  </table>
  {n.rest.length > 0 && (
    <div class="more-in">
      <h3>Ещё в рейтинге</h3>
      <ul class="more-in__list">
        {n.rest.map((r) => (
          <li {...attrs(r)}><b>{r.place}.</b> {r.url ? <a href={u(r.url)}>{r.display}</a> : r.display} – {score(r.score)} <span class="muted">({rt(r.rating)}, {num(r.reviews)} отз.{r.rayony.length > 0 && `, ${r.rayony.join(', ')}`}{r.branches.length > 1 && `, ${moreLabel(more(r))}`}{r.prices.length > 0 && `, цены на сайте ${rub(r.prices[0].from)}`})</span></li>
        ))}
      </ul>
    </div>
  )}
  <p class="flt__empty" hidden data-empty>Под эти условия никто не подошёл. Снимите часть фильтров.</p>
</div>

<script>
  import '../../scripts/filtr';
</script>

<style>
  .pick { display: inline-block; padding: 2px 8px; border-radius: 6px; background: var(--signal, #e8ff4a); color: #111; font-size: 13px; white-space: nowrap; }
  :global(.rt .is-pick) { outline: 2px solid var(--signal, currentColor); outline-offset: -2px; }
</style>
