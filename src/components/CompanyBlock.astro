---
// Компания в рейтинге: место, балл, цифры с карт, плюсы, на что обратить внимание, кому подходит, контакты.
import type { Company } from '../lib/reyting';
import { mdf } from '../lib/reyting';
import { score, telHref } from '../lib/format';
import { md, real } from '../lib/md';
import { u } from '../lib/url';
import Gauge from './Gauge.astro';
import Metrics from './Metrics.astro';
import MapLinks from './MapLinks.astro';
interface Props { c: Company }
const { c } = Astro.props;
const t = c.t;
const hours = c.hours.replace(/^./, (m) => m.toUpperCase());
---
<article class="co" id={c.slug}>
  <header class="co__head">
    <span class="co__pos">{String(c.place).padStart(2, '0')}</span>
    <h3><a href={u(c.url)}>{c.place}. {t.name}</a> <span class="sr-only">– {score(c.score)}/10</span></h3>
    <div class="co__score">{score(c.score)}<small>/10</small><Gauge value={c.score} signal={c.place <= 3} /></div>
  </header>
  <div class="co__body">
    <div class="stack">
      {real(t.note) && <p class="co__note" set:html={md(t.note)} />}
      <Metrics c={c} />
      {t.pros && (
        <div class="stack">
          <p><strong>Плюсы по данным:</strong></p>
          <ul class="pros">{t.pros.map((p) => <li set:html={mdf(p)} />)}</ul>
        </div>
      )}
      {t.attention && <p class="warn"><b>На что обратить внимание:</b> <Fragment set:html={mdf(t.attention)} /></p>}
    </div>
    <dl class="dl">
      {t.fit && <div><dt>Кому подходит</dt><dd>{t.fit}</dd></div>}
      <div><dt>Адрес и часы</dt><dd>{c.addresses.join('; ')}. {hours}.</dd></div>
      <div><dt>Телефон</dt><dd>{c.phones.map((p, i) => <>{i > 0 && '; '}<a href={telHref(p)}>{p}</a></>)}{real(t.phoneNote) && <> <Fragment set:html={md(t.phoneNote)} /></>}</dd></div>
      <div><dt>Сайт</dt><dd>{c.site ? <a href={c.site} rel="nofollow noopener" target="_blank">{c.site.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a> : 'нет в карточке'}</dd></div>
    </dl>
  </div>
  <MapLinks c={c} />
</article>
