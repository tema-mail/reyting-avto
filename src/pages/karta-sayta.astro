---
// HTML-карта сайта: город → группы → рейтинги → компании. noindex, follow.
import Doc from '../layouts/Doc.astro';
import { NICHES } from '../lib/reyting';
import { yaGoroda } from '../lib/ya';
import { katalog } from '../lib/katalog';
import { READY } from '../lib/goroda';
import { SITE_NAME } from '../lib/site';
import { u } from '../lib/url';

// город → группы → рейтинги → компании; все готовые города (с 01.11.2026 – и Краснодар)
const companies = (city: string, key: string): [string, string][] => {
  const o = city === 'novosibirsk' ? NICHES.find((n) => n.slug === key) : undefined;
  if (o) return o.companies.map((c) => [c.t.brand, c.url]);
  const y = yaGoroda(city).pub.find((n) => n.key === key)!;
  return y.top.filter((r) => r.url).map((r) => [r.display, r.url!]);
};
---
<Doc title={`Карта сайта – ${SITE_NAME}`} h1="Карта сайта" robots="noindex-follow">
  <ul class="sitemap links">
    <li><a href={u('/')}>Главная</a></li>
    <li><a href={u('/metodika/')}>Методика</a> · <a href={u('/o-proekte/')}>О проекте</a> · <a href={u('/dobavit-kompaniyu/')}>Добавить компанию</a></li>
    <li><a href={u('/politika-konfidentsialnosti/')}>Политика конфиденциальности</a> · <a href={u('/soglasie-na-obrabotku-dannykh/')}>Согласие на обработку данных</a></li>
    {READY.map((CITY) => <>
    <li><a href={u(`/${CITY.slug}/`)}>{CITY.name}: все рейтинги</a></li>
    {katalog(CITY.slug).byGroup.map((g) => (
      <li><strong>{g.name}</strong>
        <ul class="links" style="margin-top:8px;padding-left:16px">
          {g.items.map((r) => (
            <li><a href={u(r.url)}>{r.crumb}</a>
              <ul class="links" style="margin-top:6px;padding-left:16px">{companies(CITY.slug, r.key).map(([name, href]) => <li><a href={u(href)}>{name}</a></li>)}</ul>
            </li>
          ))}
        </ul>
      </li>
    ))}
    </>)}
  </ul>
</Doc>
