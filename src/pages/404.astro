---
import Base from '../layouts/Base.astro';
import { BY_GROUP } from '../lib/katalog';
import { SITE_NAME, CITY } from '../lib/site';
import { u } from '../lib/url';
---
<Base title={`Страница не найдена – ${SITE_NAME}`} robots="noindex">
  <section class="hero">
    <div class="wrap stack">
      <p class="err404">4<span>0</span>4</p>
      <h1>Такой страницы нет</h1>
      <p class="lead">Возможно, адрес набран с ошибкой или рейтинг ещё не опубликован. Вот что есть сейчас:</p>
      <ul class="links">
        <li><a href={u(`/${CITY.slug}/`)}>Все рейтинги {CITY.of}</a></li>
        {BY_GROUP.map((g) => <li><a href={u(`/${CITY.slug}/#${g.slug}`)}>{g.name}</a> – {g.items.map((r) => r.crumb).join(', ')}</li>)}
        <li><a href={u('/')}>Главная</a></li>
      </ul>
    </div>
  </section>
</Base>
