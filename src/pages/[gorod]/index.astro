---
// Страница города. Готовый город (ready, рейтинги собраны) – хаб со всеми рейтингами (GorodHub);
// город без данных – честная страница «рейтинг собирается», закрыта от поиска (GorodSkoro).
import GorodHub from '../../components/GorodHub.astro';
import GorodSkoro from '../../components/GorodSkoro.astro';
import { GORODA, type Gorod } from '../../lib/goroda';

export function getStaticPaths() {
  return GORODA.map((x) => ({ params: { gorod: x.slug }, props: { c: x } }));
}
interface Props { c: Gorod }
const { c } = Astro.props;
---
{c.ready ? <GorodHub c={c} /> : <GorodSkoro c={c} />}
