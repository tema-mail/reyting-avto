---
// Страница города. Готовый город – каталог всех организаций автониши (владелец 01.11.2026: «в городе – сначала каталог»),
// рейтинги – вкладкой /<город>/ratings/; город без данных – честная страница «рейтинг собирается» (noindex).
import GorodKatalog from '../../components/GorodKatalog.astro';
import GorodSkoro from '../../components/GorodSkoro.astro';
import { GORODA, type Gorod } from '../../lib/goroda';

export function getStaticPaths() {
  return GORODA.map((x) => ({ params: { gorod: x.slug }, props: { c: x } }));
}
interface Props { c: Gorod }
const { c } = Astro.props;
---
{c.ready ? <GorodKatalog c={c} /> : <GorodSkoro c={c} />}
