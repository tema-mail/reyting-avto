---
import Today from '../../../components/Today.astro';
// Каталог всех компаний из рейтингов (30.10.2026): поиск по названию и адресу, фильтр по нише и району.
// Порядок – по числу отзывов на Яндекс Картах; фильтр только скрывает строки (скрипт ниже, без фреймворка).
// Свой каталог у каждого готового города (01.11.2026); фильтр по району – там, где есть границы районов.
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { yaGoroda } from '../../../lib/ya';
import { COMPANIES as OLD_COMPANIES, NICHES } from '../../../lib/reyting';
import { katalog } from '../../../lib/katalog';
import { RAYON_LIST as NSK_RAYONY } from '../../../lib/rayon-stranitsy';
import { rt, otz } from '../../../lib/ya-tekst';
import { YA_DATE } from '../../../lib/site';
import { READY, type Gorod } from '../../../lib/goroda';
import { num, date } from '../../../lib/format';
import { u, abs } from '../../../lib/url';

export function getStaticPaths() {
  return READY.map((c) => ({ params: { gorod: c.slug }, props: { c } }));
}
interface Props { c: Gorod }
const CITY = Astro.props.c;
const nsk = CITY.slug === 'novosibirsk';
const ENTITIES = yaGoroda(CITY.slug).entities;
const COMPANIES = nsk ? OLD_COMPANIES : [];
const RATINGS = katalog(CITY.slug).ratings;
const RAYON_LIST = nsk ? NSK_RAYONY : [];
interface Item { name: string; url: string; niches: string[]; rayony: string[]; address: string; rating: number; reviews: number }
const crumbOld = (k: string) => NICHES.find((n) => n.slug === k)!.t.crumb;
const items: Item[] = [
  ...ENTITIES.map((e) => {
    const old = e.oldSlug ? COMPANIES.filter((c) => c.slug === e.oldSlug).map((c) => c.niche) : [];
    const b = e.rows[0].branches[0];
    return {
      name: e.label,
      url: e.url,
      niches: [...new Set([...e.rows.map((r) => r.niche), ...old])],
      rayony: [...new Set(e.branches.map((x) => x.rayon).filter(Boolean))],
      address: b.address + (e.branches.length > 1 ? ` и ещё ${e.branches.length - 1}` : ''),
      rating: e.rows[0].rating,
      reviews: Math.max(...e.rows.map((r) => r.reviews)),
    };
  }),
  ...COMPANIES.filter((c) => !ENTITIES.some((e) => e.oldSlug === c.slug)).map((c) => ({
    name: c.t.brand, url: c.url, niches: [c.niche], rayony: [] as string[], address: c.addresses[0] || '', rating: c.rating, reviews: c.reviews,
  })),
].sort((a, b) => b.reviews - a.reviews || a.name.localeCompare(b.name));
// одна компания может быть в двух старых нишах – одна строка
const seen = new Set<string>();
const list = items.filter((x) => (seen.has(x.url) ? false : (seen.add(x.url), true)));
const crumb = (k: string) => RATINGS.find((r) => r.key === k)?.crumb || crumbOld(k);
const niches = RATINGS.map((r) => [r.key, r.crumb] as const);
const h1 = `Автосервисы и автоуслуги ${CITY.of}: каталог ${num(list.length)} компаний`;
const title = `Все автосервисы ${CITY.of} – каталог и рейтинги`;
const desc = `${num(list.length)} автокомпаний ${CITY.of} из ${RATINGS.length} рейтингов: поиск по названию и адресу, фильтр по услуге${RAYON_LIST.length ? ' и району' : ''}, оценки Яндекс Карт.`.slice(0, 160);
const pageUrl = abs(`/${CITY.slug}/companies/`, Astro.site);
const schema = [
  { '@type': 'CollectionPage', '@id': pageUrl + '#page', url: pageUrl, name: h1, description: desc, inLanguage: 'ru', dateModified: nsk ? YA_DATE : RATINGS.map((r) => r.date).sort().pop() },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: abs('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: CITY.name, item: abs(`/${CITY.slug}/`, Astro.site) },
      { '@type': 'ListItem', position: 3, name: 'Все компании', item: pageUrl },
    ],
  },
];
---
<Base title={title} description={desc} schema={schema}>
  <Crumbs items={[['Главная', '/'], [CITY.name, `/${CITY.slug}/`], ['Все компании']]} />

  <section class="hero">
    <div class="wrap stack">
      <p class="label">Каталог · данные на <Today /></p>
      <h1>{h1}</h1>
      <p class="lead">Все компании, которые прошли отбор хотя бы в один наш рейтинг. Найдите сервис по названию, улице, услуге{RAYON_LIST.length > 0 ? ' или району' : ''} – в карточке адрес, часы, телефон и место в рейтингах. Порядок – по числу отзывов на Яндекс Картах.</p>
      <p class="small"><a href={u(`/${CITY.slug}/`)}>Рейтинги по услугам</a>{RAYON_LIST.length > 0 && <> · Районы: {RAYON_LIST.map((r, i) => <>{i > 0 && ', '}<a href={u(r.url)}>{r.name}</a></>)}</>}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap stack">
      <div class="flt" data-kat>
        <div class="kat__row">
          <label class="flt__sel"><span>Название или улица</span><input type="search" data-q placeholder={nsk ? 'Например, Фрунзе или Reaktor' : (list.length ? `Например, ${list[0].name}` : 'Название или улица')} /></label>
          <label class="flt__sel"><span>Услуга</span>
            <select data-n><option value="">Все услуги</option>{niches.map(([k, c]) => <option value={k}>{c}</option>)}</select>
          </label>
          {RAYON_LIST.length > 0 ? <label class="flt__sel"><span>Район</span>
            <select data-r><option value="">Все районы</option>{RAYON_LIST.map((r) => <option value={r.name}>{r.name}</option>)}</select>
          </label> : <select data-r hidden aria-hidden="true"><option value=""></option></select>}
        </div>
        <p class="small muted" aria-live="polite" data-c>Показаны все {num(list.length)}.</p>
      </div>
      <ul class="kat">
        {list.map((x) => (
          <li data-s={`${x.name} ${x.address}`.toLowerCase()} data-n={x.niches.join(' ')} data-r={x.rayony.join('|')}>
            <a href={u(x.url)}><b>{x.name}</b></a>
            <span class="small muted">{x.address}{x.rayony.length > 0 && ` · ${x.rayony.join(', ')}`}</span>
            <span class="small">{x.niches.map(crumb).join(', ')}</span>
            <span class="small mono">Я {rt(x.rating)} · {otz(x.reviews)}</span>
          </li>
        ))}
      </ul>
      <p class="small muted" data-none hidden>Ничего не нашли. Попробуйте другое слово или сбросьте фильтр.</p>
    </div>
  </section>
</Base>

<script>
  const box = document.querySelector('[data-kat]');
  if (box) {
    const q = box.querySelector<HTMLInputElement>('[data-q]')!;
    const n = box.querySelector<HTMLSelectElement>('[data-n]')!;
    const r = box.querySelector<HTMLSelectElement>('[data-r]')!;
    const c = box.querySelector<HTMLElement>('[data-c]')!;
    const none = document.querySelector<HTMLElement>('[data-none]')!;
    const rows = [...document.querySelectorAll<HTMLElement>('.kat li')];
    const run = () => {
      const s = q.value.trim().toLowerCase();
      let k = 0;
      for (const li of rows) {
        const ok = (!s || li.dataset.s!.includes(s)) && (!n.value || li.dataset.n!.split(' ').includes(n.value)) && (!r.value || li.dataset.r!.split('|').includes(r.value));
        li.hidden = !ok;
        if (ok) k++;
      }
      c.textContent = s || n.value || r.value ? `Найдено: ${k} из ${rows.length}.` : `Показаны все ${rows.length}.`;
      none.hidden = k > 0;
    };
    [q, n, r].forEach((el) => el.addEventListener('input', run));
  }
</script>

<style>
  .kat__row { display: grid; gap: 12px; }
  @media (min-width: 900px) { .kat__row { grid-template-columns: minmax(0, 1fr) 260px 220px; align-items: end; } }
  .kat__row input { width: 100%; font-size: 16px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg, #fff); color: inherit; }
  .kat { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  @media (min-width: 900px) { .kat { grid-template-columns: 1fr 1fr; } }
  .kat li { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--r, 10px); background: var(--card, transparent); }
  .kat li[hidden] { display: none; }
</style>
