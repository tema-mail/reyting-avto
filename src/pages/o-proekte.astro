---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { NICHES, COMPANIES } from '../lib/reyting';
import { SITE_NAME, DATA_DATE, CITY } from '../lib/site';
import { date } from '../lib/format';
import { md } from '../lib/md';
import { u, abs } from '../lib/url';
const site = Astro.site;
const schema = [
  { '@type': 'AboutPage', url: abs('/o-proekte/', site), name: `О проекте ${SITE_NAME}`, inLanguage: 'ru', about: { '@id': abs('/', site) + '#org' } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: abs('/', site) }, { '@type': 'ListItem', position: 2, name: 'О проекте', item: abs('/o-proekte/', site) }] },
];
---
<Base title={`О проекте ${SITE_NAME}: кто составляет рейтинги и зачем`} description="Кто делает рейтинги автосервисов и установочных центров, на чём зарабатываем, как связаться и исправить ошибку. Места в рейтинге не продаются." schema={schema}>
  <Crumbs items={[['Главная', '/'], ['О проекте']]} />
  <section class="hero">
    <div class="wrap stack">
      <h1>О проекте {SITE_NAME}</h1>
      <p class="lead" style="max-width:800px">{SITE_NAME} составляет рейтинги автосервисов и установочных центров по открытым данным: Яндекс Карты, 2ГИС и сайты компаний. Сейчас в проекте {NICHES.length === 2 ? 'два рейтинга' : NICHES.length + ' рейтинга'} {CITY.of}, {COMPANIES.length} компании, данные на {date(DATA_DATE)}.</p>
      <p class="small" set:html={md(`{?название «${SITE_NAME}» рабочее – название и домен выбирает владелец?}`)} />
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>Кто составляет рейтинги</h2>
      <p set:html={md('{?раскрываем ли владельца. Вариант «да»: «Рейтинги ведёт [имя / компания]. Мы делаем сайты и продвижение для автобизнеса, поэтому знаем, как в нише выглядят цены, отзывы и статусы». Вариант «нет»: «Рейтинги ведёт редакция проекта»?}')} />
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>На чём зарабатываем и чего не делаем</h2>
      <p set:html={md('{?модель заработка?}')} />
      <p>Чего не делаем: не продаём места, не размещаем рекламу на страницах рейтингов, не меняем баллы по просьбе компаний. Ссылки на сайты компаний не рекламные.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>Связь с компаниями из рейтинга</h2>
      <p set:html={md('{?раскрываем ли, что Teyes Sibir – клиент команды. Если да: «Teyes Sibir (3-е место в рейтинге установки магнитол) – клиент команды, которая ведёт сайт. Его балл посчитан той же формулой, что у остальных. Рядом с компанией в рейтинге стоит такая же пометка»?}')} />
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>Как связаться и исправить ошибку</h2>
      <p>Ошибку в данных пришлите через форму «Добавить компанию» со ссылкой на источник. Для остальных вопросов – <Fragment set:html={md('{?почта проекта?}')} />.</p>
      <p><a href={u('/metodika/')}>Методика</a> · <a href={u('/dobavit-kompaniyu/')}>Добавить компанию</a> · <a href={u('/politika-konfidentsialnosti/')}>Политика конфиденциальности</a></p>
    </div>
  </section>
</Base>
