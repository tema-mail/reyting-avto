---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { katalog } from '../lib/katalog';
import { READY } from '../lib/goroda';
import { SITE_NAME } from '../lib/site';
import { num, plural } from '../lib/format';
import { md } from '../lib/md';
import { u, abs } from '../lib/url';
const site = Astro.site;
const schema = [
  { '@type': 'AboutPage', url: abs('/o-proekte/', site), name: `О проекте ${SITE_NAME}`, inLanguage: 'ru', about: { '@id': abs('/', site) + '#org' } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: abs('/', site) }, { '@type': 'ListItem', position: 2, name: 'О проекте', item: abs('/o-proekte/', site) }] },
];
---
<Base title={`О проекте ${SITE_NAME}: кто составляет рейтинги`} description="Кто делает авто-рейтинги, по каким данным и как исправить ошибку в рейтинге." schema={schema}>
  <Crumbs items={[['Главная', '/'], ['О проекте']]} />
  <section class="hero">
    <div class="wrap stack">
      <h1>О проекте {SITE_NAME}</h1>
      <p class="lead" style="max-width:800px">{SITE_NAME} составляет рейтинги авто-ниш по открытым данным: Яндекс Карты, а для двух первых ниш ещё 2ГИС и сайты компаний. Сейчас в проекте {READY.map((c) => { const t = katalog(c.slug).totals; return `${t.ratings} ${plural(t.ratings, ['рейтинг', 'рейтинга', 'рейтингов'])} ${c.of} (${num(t.companies)} ${plural(t.companies, ['компания', 'компании', 'компаний'])})`; }).join(' и ')}.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>Кто составляет рейтинги</h2>
      <p set:html={md('Рейтинги ведёт редакция проекта. Гиды «куда обратиться и как выбрать» пишет [Артём Галимов](/avtory/artem-galimov/) – журналист, автор рейтинга: он снимает карточки компаний с карт, сверяет отзывы, сайты и цены и считает баллы по одной формуле для всех.')} />
    </div>
  </section>
  <section class="sec">
    <div class="wrap prose">
      <h2>Как связаться и исправить ошибку</h2>
      <p>Ошибку в данных пришлите через форму «Добавить компанию» со ссылкой на источник.</p>
      <p><a href={u('/metodika/')}>Методика</a> · <a href={u('/dobavit-kompaniyu/')}>Добавить компанию</a> · <a href={u('/politika-konfidentsialnosti/')}>Политика конфиденциальности</a></p>
    </div>
  </section>
</Base>
