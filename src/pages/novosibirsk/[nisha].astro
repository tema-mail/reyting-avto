---
// Рейтинг «ниша × город». Две ниши на данных Яндекс Карт и 2ГИС (формула v2) – StaryyReyting;
// ниши «только Яндекс Карты» (съём 28.10.2026, формула владельца) – YaReyting.
import StaryyReyting from '../../components/StaryyReyting.astro';
import YaReyting from '../../components/ya/YaReyting.astro';
import { NICHES, type Niche } from '../../lib/reyting';
import { NICHES_YA_PUB, type NicheYa } from '../../lib/ya';

export function getStaticPaths() {
  return [
    ...NICHES.map((n) => ({ params: { nisha: n.slug }, props: { n, y: null } })),
    ...NICHES_YA_PUB.map((y) => ({ params: { nisha: y.key }, props: { n: null, y } })),
  ];
}
interface Props { n: Niche | null; y: NicheYa | null }
const { n, y } = Astro.props;
---
{n ? <StaryyReyting n={n} /> : <YaReyting n={y!} />}
