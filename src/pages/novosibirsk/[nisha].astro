---
// Рейтинг «ниша × город» (Каталог): Коротко → таблица → номинации → компании → помощь → как считали →
// чек-лист → цены → FAQ → другие рейтинги → «вашей компании нет». Порядок – план блоков и SEO-задание.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import RatingTable from '../../components/RatingTable.astro';
import CompanyBlock from '../../components/CompanyBlock.astro';
import HelpForm from '../../components/HelpForm.astro';
import Gauge from '../../components/Gauge.astro';
import { NICHES, mdf, plain, type Niche } from '../../lib/reyting';
import { CITY, DATA_DATE, PUBLISHED } from '../../lib/site';
import { score, rating, num, date, telHref } from '../../lib/format';
import { md } from '../../lib/md';
import { u, abs } from '../../lib/url';

export function getStaticPaths() {
  return NICHES.map((n) => ({ params: { nisha: n.slug }, props: { n } }));
}
interface Props { n: Niche }
const { n } = Astro.props;
const t = n.t;
const top = n.companies.slice(0, 3);
const detailed = n.companies.filter((c) => c.t.pros);
const rest = n.companies.filter((c) => !c.t.pros);
const others = NICHES.filter((x) => x.slug !== n.slug);
const site = Astro.site;
const pageUrl = abs(n.url, site);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': pageUrl + '#page',
    url: pageUrl,
    name: t.h1,
    description: t.description,
    inLanguage: 'ru',
    datePublished: PUBLISHED,
    dateModified: n.date,
    publisher: { '@id': abs('/', site) + '#org' },
    mainEntity: { '@id': pageUrl + '#list' },
  },
  {
    '@type': 'ItemList',
    '@id': pageUrl + '#list',
    name: t.tableH2,
    numberOfItems: n.companies.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: n.companies.map((c) => ({
      '@type': 'ListItem',
      position: c.place,
      item: {
        '@type': t.schemaType,
        '@id': abs(c.url, site) + '#company',
        name: c.t.brand,
        url: abs(c.url, site),
        address: { '@type': 'PostalAddress', streetAddress: c.addresses[0], addressLocality: CITY.name, addressCountry: 'RU' },
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: abs('/', site) },
      { '@type': 'ListItem', position: 2, name: CITY.name, item: abs(`/${CITY.slug}/`, site) },
      { '@type': 'ListItem', position: 3, name: t.crumb, item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: plain(a) } })),
  },
];
---
<Base title={t.title} description={t.description} schema={schema} active={n.slug} sticky>
  <Crumbs items={[['Главная', '/'], [CITY.name, `/${CITY.slug}/`], [t.crumb]]} />

  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="label">Рейтинг · {CITY.name} · данные на {date(n.date)}</p>
        <h1>{t.h1}</h1>
        <p class="short lead"><span class="short__k">Коротко:</span><Fragment set:html={mdf(t.short)} /> {t.shortAfter}</p>
        {t.disclosure && <p class="small" style="margin-top:10px" set:html={md(t.disclosure)} />}
        <ul class="facts">{t.bullets.map((b) => <li>{b}</li>)}</ul>
        <div class="btns">
          <a class="btn btn--signal" href="#tablitsa">Смотреть рейтинг</a>
          <a class="btn btn--ghost" href="#pomoch">Помочь выбрать</a>
        </div>
      </div>
      <aside class="board" aria-label="Первые три места">
        <p class="board__h"><span>Тройка лидеров</span><span>балл / 10</span></p>
        {top.map((c) => (
          <a class="board__row" href={u(c.url)}>
            <span class="board__pos">{String(c.place).padStart(2, '0')}</span>
            <span class="board__name">{c.t.brand}<br /><span class="small muted mono">Я {rating(c.y.rating)} · 2ГИС {rating(c.g.rating)} · {num(c.reviews)} отз.</span></span>
            <span class="board__score">{score(c.score)}</span>
            <Gauge value={c.score} signal />
          </a>
        ))}
      </aside>
    </div>
  </section>

  <section class="sec" id="tablitsa">
    <div class="wrap">
      <div class="sec__head">
        <p class="label">01 · Таблица баллов</p>
        <h2>{t.tableH2}</h2>
        <p>{t.tableLead}</p>
      </div>
      <RatingTable n={n} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">02 · Номинации по данным</p><h2>{t.bestH2}</h2></div>
      <ul class="nom">{t.best.map((b) => <li set:html={mdf(b)} />)}</ul>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">03 · Подробно</p><h2>{t.detailH2}</h2></div>
      <div class="co-list">
        {detailed.map((c) => <CompanyBlock c={c} />)}
      </div>
      {rest.length > 0 && (
        <div class="stack" style="margin-top:28px">
          <h3>{rest[0].place}–{rest[rest.length - 1].place}. {t.restH3}</h3>
          <ul class="rest">
            {rest.map((c) => (
              <li>
                <strong>{c.place}. <a href={u(c.url)}>{c.t.name}</a> – {score(c.score)}.</strong> Яндекс {rating(c.y.rating)} ({num(c.y.reviews)}), 2ГИС {rating(c.g.rating)} ({num(c.g.reviews)}). <Fragment set:html={mdf(c.t.short || '')} /> {c.addresses.join('; ')} · <a href={telHref(c.phones[0])}>{c.phones[0]}</a> · <a href={c.y.cards[0]} rel="nofollow noopener" target="_blank">Яндекс Карты</a> · <a href={c.g.cards[0]} rel="nofollow noopener" target="_blank">2ГИС</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="sec">
    <div class="wrap"><HelpForm n={n} /></div>
  </section>

  <section class="sec" id="kak-schitali">
    <div class="wrap">
      <div class="sec__head"><p class="label">04 · Методика коротко</p><h2>{t.howH2}</h2></div>
      <div class="prose">
        <p>{t.how}</p>
        <p><a href={u(`/metodika/#${n.slug}`)}>Полная методика и формула →</a></p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">05 · Чек-лист</p><h2>{t.checkH2}</h2></div>
      <ol class="check">{t.check.map((q) => <li set:html={md(q)} />)}</ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">06 · Цены</p><h2>{t.pricesH2}</h2><p>{t.pricesLead}</p></div>
      <div class="tbl-wrap">
        <table class="tbl tbl--stack">
          <thead><tr><th scope="col">Работа</th><th scope="col">Цена на сайте</th><th scope="col">Чья цена</th></tr></thead>
          <tbody>{t.prices.map(([w, p, who]) => <tr><td>{w}</td><td class="num" set:html={md(p)} /><td>{who}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{t.pricesNote}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">07 · Вопросы</p><h2>Частые вопросы</h2></div>
      <div class="faq">
        {t.faq.map(([q, a], i) => (
          <details open={i === 0}>
            <summary>{q}</summary>
            <div><p set:html={mdf(a)} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">08 · Ещё рейтинги</p><h2>Другие авто-рейтинги {CITY.of}</h2></div>
      <ul class="links">
        {others.map((o) => <li><a href={u(o.url)}>{o.t.crumb} {CITY.in}</a> – {o.companies.length} {o.t.whoGen}, №1 {o.companies[0].t.brand} ({score(o.companies[0].score)}/10)</li>)}
        <li class="muted">{t.otherNote}</li>
      </ul>
    </div>
  </section>

  <section class="sec sec--dark">
    <div class="wrap cta-band">
      <div class="stack">
        <h2>{t.addH2}</h2>
        <p>{t.add}</p>
      </div>
      <a class="btn btn--signal" href={u('/dobavit-kompaniyu/')}>Добавить или уточнить данные</a>
    </div>
  </section>
  <section class="sec sec--flush">
    <div class="wrap"><p class="small muted">Данные рейтинга на {date(DATA_DATE)}. Следующее обновление – <Fragment set:html={md('{?дата?}')} />.</p></div>
  </section>

  <div class="sticky" slot="after">
    <a class="btn btn--signal" href="#pomoch">Помочь выбрать</a>
    <a class="btn btn--ghost" style="color:#fff;border-color:#4a525b" href="#tablitsa">К рейтингу ↑</a>
  </div>
</Base>
