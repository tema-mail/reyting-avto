---
// Карточка компании /novosibirsk/kompanii/<slug>/. Компании двух старых ниш (Я+2ГИС) – StarayaKartochka
// (места в нишах Яндекса добавлены строками); новые компании из топ-10 ниш Яндекса – YaKartochka.
import StarayaKartochka from '../../../components/StarayaKartochka.astro';
import YaKartochka from '../../../components/ya/YaKartochka.astro';
import { COMPANIES, type Company } from '../../../lib/reyting';
import { NEW_CARDS, type Entity } from '../../../lib/ya';

export function getStaticPaths() {
  return [
    ...COMPANIES.map((c) => ({ params: { slug: c.slug }, props: { c, e: null } })),
    ...NEW_CARDS.map((e) => ({ params: { slug: e.slug }, props: { c: null, e } })),
  ];
}
interface Props { c: Company | null; e: Entity | null }
const { c, e } = Astro.props;
---
{c ? <StarayaKartochka c={c} /> : <YaKartochka e={e!} />}
