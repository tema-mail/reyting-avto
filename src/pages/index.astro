---
// Главная: про проект и методику, без города в title (город – у хаба).
import Base from '../layouts/Base.astro';
import RatingsGrid from '../components/ya/RatingsGrid.astro';
import { TOTALS } from '../lib/katalog';
import { NICHES_YA_PUB } from '../lib/ya';
import { W_YA } from '../lib/formula-ya.mjs';
import { SITE_NAME, YA_DATE, CITY } from '../lib/site';
import { num, date, plural } from '../lib/format';
import { u, abs } from '../lib/url';

const site = Astro.site;
const schema = [{ '@type': 'WebSite', '@id': abs('/', site) + '#site', url: abs('/', site), name: SITE_NAME, inLanguage: 'ru', publisher: { '@id': abs('/', site) + '#org' } }];
---
<Base title={`${SITE_NAME} – рейтинги автосервисов, автошкол и детейлинга по отзывам`} description={`${TOTALS.ratings} рейтингов автосервисов, автошкол, детейлинга и других авто-ниш ${CITY.of} по отзывам Яндекс Карт. Открытая формула.`} schema={schema}>
  <section class="sec sec--dark" style="padding-top:48px">
    <div class="wrap">
      <p class="label">Авто-рейтинги по открытой формуле</p>
      <h1 style="margin:16px 0 20px;max-width:900px;color:#fff">Рейтинги автосервисов, автошкол и детейлинга – по отзывам с карт</h1>
      <p class="lead" style="max-width:780px">{SITE_NAME} ранжирует автосервисы, автошколы, детейлинг, шиномонтаж и другие авто-ниши {CITY.of} по открытой формуле: оценка и число отзывов на Яндекс Картах, свежесть отзывов, открытость карточки. Данные обновляем раз в месяц.</p>
      <div class="stats">
        <div class="stat"><b>{TOTALS.ratings}</b><span>{plural(TOTALS.ratings, ['рейтинг', 'рейтинга', 'рейтингов'])} {CITY.of}</span></div>
        <div class="stat"><b>{num(TOTALS.companies)}</b><span>{plural(TOTALS.companies, ['компания', 'компании', 'компаний'])} в рейтингах</span></div>
        <div class="stat"><b>{num(TOTALS.yaReviews)}</b><span>отзывов Яндекс Карт в расчёте</span></div>
        <div class="stat"><b>{date(YA_DATE)}</b><span>данные на эту дату</span></div>
      </div>
      <div class="btns" style="margin-top:28px"><a class="btn btn--signal" href="#goroda">Выбрать рейтинг</a></div>
    </div>
  </section>

  <section class="sec sec--flush" id="goroda">
    <div class="wrap">
      <div class="sec__head"><p class="label">01 · Рейтинги</p><h2>Рейтинги {CITY.of}</h2><p>Выберите группу – останутся только её рейтинги. Другие города добавим, когда в городе наберётся пять компаний с данными и свой спрос.</p></div>
      <RatingsGrid id="home" h="h3" />
      <p><a href={u(`/${CITY.slug}/`)}>Все рейтинги {CITY.of} на одной странице →</a></p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">02 · Формула</p><h2>Как мы считаем места</h2></div>
      <div class="prose">
        <p>Балл от 0 до 10. В {NICHES_YA_PUB.length} рейтингах источник один – Яндекс Карты: оценка, число отзывов, их свежесть и открытость карточки (сайт, часы, подтверждение владельцем, «Хорошее место»). Веса одинаковы для всех компаний ниши. Сеть стоит одной строкой, балл – по точке с наибольшим числом оценок. Цены с сайтов компаний показываем рядом, в балл они не входят.</p>
        <p class="formula">балл = 10 × (<b>{num(W_YA.rating, 2)}</b> × оценка + <b>{num(W_YA.reviews, 2)}</b> × отзывы + <b>{num(W_YA.fresh, 2)}</b> × свежесть + <b>{num(W_YA.open, 2)}</b> × открытость)</p>
        <p>Рейтинги установки магнитол и сервиса китайских автомобилей считаются по Яндекс Картам и 2ГИС с профилем ниши (статус дилера, цены на сайте) – формула для них своя и тоже открыта.</p>
        <p><a href={u('/metodika/')}>Формула и веса по нишам →</a></p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">03 · Доверие</p><h2>Почему рейтингу можно верить</h2></div>
      <ol class="trust">
        <li>У каждой цифры есть источник и дата: оценка и число отзывов со ссылкой на карточку Яндекс Карт.</li>
        <li>Формулу видно целиком. Вы можете пересчитать балл любой компании сами.</li>
        <li>Над каждым рейтингом – выбор редакции: компании-партнёры проекта, которые мы рекомендуем. Ниже – все остальные по формуле.</li>
        <li>У каждой компании мы пишем, на что обратить внимание: мало отзывов, давно не было новых, нет сайта или часов в карточке.</li>
      </ol>
    </div>
  </section>

  <section class="sec sec--dark">
    <div class="wrap cta-band">
      <div class="stack"><h2>Вашей компании нет в рейтинге?</h2><p>Пришлите название и ссылку на Яндекс Карты. Мы проверим данные и посчитаем балл по той же формуле. Это бесплатно.</p></div>
      <a class="btn btn--signal" href={u('/dobavit-kompaniyu/')}>Добавить компанию</a>
    </div>
  </section>
</Base>
