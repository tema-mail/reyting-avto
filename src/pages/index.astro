---
// Главная (владелец 01.11.2026): каталог компаний автониши, первым блоком – выбор города; ниже коротко – рейтинги и формула.
import Base from '../layouts/Base.astro';
import { katalog } from '../lib/katalog';
import { NICHES_YA_PUB } from '../lib/ya';
import { W_YA } from '../lib/formula-ya.mjs';
import { SITE_NAME } from '../lib/site';
import { polnyy } from '../lib/katalog-polnyy';
import { num } from '../lib/format';
import { u, abs } from '../lib/url';
import { GORODA, READY } from '../lib/goroda';

const site = Astro.site;
const schema = [{ '@type': 'WebSite', '@id': abs('/', site) + '#site', url: abs('/', site), name: SITE_NAME, inLanguage: 'ru', publisher: { '@id': abs('/', site) + '#org' } }];
---
<Base title={`${SITE_NAME} – каталог автосервисов и автоуслуг с рейтингами по отзывам`} description="Каталог автосервисов, шиномонтажа, моек, детейлинга и других автоуслуг вашего города: адреса, оценки Яндекс Карт и рейтинги по открытой формуле." schema={schema}>
  <section class="sec sec--dark" style="padding-top:48px">
    <div class="wrap">
      <p class="label">Каталог автоуслуг с рейтингами</p>
      <h1 style="margin:16px 0 20px;max-width:900px;color:#fff">Автосервисы и автоуслуги вашего города – каталог с рейтингами по отзывам</h1>
      <p class="lead" style="max-width:780px">Ремонт и ТО, шиномонтаж, мойки, детейлинг, тонировка, автошколы и другие автоуслуги: все компании города с Яндекс Карт – с адресом, услугами и оценкой. Лучшие по отзывам собраны в рейтинги по открытой формуле.</p>
      <div class="btns" style="margin-top:28px"><a class="btn btn--signal" href="#goroda">Выбрать город</a></div>
    </div>
  </section>

  <section class="sec" id="goroda">
    <div class="wrap">
      <div class="sec__head"><p class="label">01 · Города</p><h2>Выберите город</h2></div>
      <ul class="goroda">
        {GORODA.map((g) => (
          <li><a href={u(`/${g.slug}/`)}><b>{g.name}</b><span class="small muted">{g.ready ? `${num(polnyy(g.slug).stats.all)} компаний · ${katalog(g.slug).totals.ratings} рейтингов` : 'каталог собирается'}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--flush" id="reytingi">
    <div class="wrap">
      <div class="sec__head"><p class="label">02 · Рейтинги</p><h2>Рейтинги по услугам</h2></div>
      <div class="prose">
        <p>В каждом городе рядом с каталогом – отдельная вкладка рейтингов: по каждой услуге берём профильные компании с оценкой от 4,0 и минимум 10 отзывами и ставим места по баллу.</p>
        <ul>{READY.map((g) => <li><a href={u(`/${g.slug}/ratings/`)}>Рейтинги {g.of}</a> – {katalog(g.slug).totals.ratings} рейтингов, {num(polnyy(g.slug).stats.rated)} компаний</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">03 · Формула</p><h2>Как мы считаем места</h2></div>
      <div class="prose">
        <p>Балл от 0 до 10. В {NICHES_YA_PUB.length} рейтингах источник один – Яндекс Карты: оценка, число отзывов, их свежесть и открытость карточки (сайт, часы, подтверждение владельцем, «Хорошее место»). Веса одинаковы для всех компаний ниши. Сеть стоит одной строкой, балл – по точке с наибольшим числом оценок. Цены с сайтов компаний показываем рядом, в балл они не входят.</p>
        <p class="formula">балл = 10 × (<b>{num(W_YA.rating, 2)}</b> × оценка + <b>{num(W_YA.reviews, 2)}</b> × отзывы + <b>{num(W_YA.fresh, 2)}</b> × свежесть + <b>{num(W_YA.open, 2)}</b> × открытость)</p>
        <p>Рейтинги установки магнитол и сервиса китайских автомобилей считаются по Яндекс Картам и 2ГИС с профилем ниши (статус дилера, цены на сайте) – формула для них своя и тоже открыта.</p>
        <p><a href={u('/metodika/')}>Формула и веса по нишам →</a></p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec__head"><p class="label">04 · Доверие</p><h2>Почему рейтингу можно верить</h2></div>
      <ol class="trust">
        <li>У каждой цифры есть источник и дата: оценка и число отзывов со ссылкой на карточку Яндекс Карт.</li>
        <li>Формулу видно целиком. Вы можете пересчитать балл любой компании сами.</li>
        <li>У каждой компании мы пишем, на что обратить внимание: мало отзывов, давно не было новых, нет сайта или часов в карточке.</li>
      </ol>
    </div>
  </section>

  <section class="sec sec--dark">
    <div class="wrap cta-band">
      <div class="stack"><h2>Вашей компании нет в рейтинге?</h2><p>Пришлите название и ссылку на Яндекс Карты. Мы проверим данные и посчитаем балл по той же формуле. Это бесплатно.</p></div>
      <a class="btn btn--signal" href={u('/dobavit-kompaniyu/')}>Добавить компанию</a>
    </div>
  </section>
</Base>

<style>
  .goroda { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @media (min-width: 900px) { .goroda { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .goroda a { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--r); background: var(--card); text-decoration: none; }
  .goroda a:hover { border-color: var(--signal); }
</style>
